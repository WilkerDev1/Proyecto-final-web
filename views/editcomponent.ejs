<%- include('layouts/header') %>

<div class="container px-5 my-5">
    <div class="row">
        <div class="col-md-3"></div>

        <div class="col-md-6">

            <h1>Editar Componente (<%= component.name %>)</h1>

            <form id="add-form" action="/update/<%= component._id %>" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label" for="name">Nombre</label>
                    <input class="form-control" value="<%= component.name %>" name="name" type="text" placeholder="Ingresa nombre" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="descripcion">Descripción</label>
                    <textarea class="form-control" name="descripcion" required><%= component.descripcion %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="codigo">Código</label>
                    <input class="form-control" value="<%= component.codigo %>" name="codigo" type="text" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="precio">Precio</label>
                    <input class="form-control" value="<%= component.precio %>" name="precio" type="number" step="0.01" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="cantidad">Cantidad</label>
                    <input class="form-control" value="<%= component.cantidad %>" name="cantidad" type="number" required>
                </div>

                <!-- Imagen anterior -->
                <input type="hidden" name="old_image" value="<%= component.image %>">

                <div class="mb-3">
                    <label for="image" class="form-label">Foto</label>
                    <input name="image" class="form-control" type="file">
                    <img src="/<%= component.image %>" width="100" class="img-thumbnail mt-1">
                </div>

                <div class="d-grid">
                    <input type="submit" class="btn btn-primary btn-lg" value="Editar Componente">
                </div>

            </form>
        </div>

        <div class="col-md-3"></div>
    </div>
</div>

<%- include('layouts/footer') %>
