<%- include('layouts/header') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Componente</h4>
                </div>
                <div class="card-body p-4">
                    <form action="/update/<%= component._id %>" method="post" id="edit-form" enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label for="nombre" class="form-label fw-bold">Nombre</label>
                            <input type="text" name="nombre" class="form-control" value="<%= component.nombre %>" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="marca" class="form-label fw-bold">Marca</label>
                                <input type="text" name="marca" class="form-control" value="<%= component.marca %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="categoria" class="form-label fw-bold">Categoría</label>
                                <input type="text" name="categoria" class="form-control" value="<%= component.categoria %>" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label fw-bold">Descripción</label>
                            <textarea name="descripcion" class="form-control" rows="2" required><%= component.descripcion %></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="precio" class="form-label fw-bold">Precio ($)</label>
                                <input type="number" name="precio" class="form-control" value="<%= component.precio %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="stock" class="form-label fw-bold">Stock</label>
                                <input type="number" name="stock" class="form-control" value="<%= component.stock %>" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="image" class="form-label fw-bold">Cambiar Imagen</label>
                            <input type="file" name="image" class="form-control mb-2">
                            <div class="text-center">
                                <img src="/<%= component.image %>" width="120" class="img-thumbnail rounded">
                                <small class="d-block text-muted">Imagen actual</small>
                            </div>
                        </div>
                        
                        <input type="hidden" name="old_image" value="<%= component.image %>">

                        <div class="d-grid gap-2">
                            <input type="submit" name="submit" value="Actualizar Componente" class="btn btn-success btn-lg shadow-sm">
                            <a href="/" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>