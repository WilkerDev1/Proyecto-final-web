<%- include('layouts/header') %>

<div class="container my-4">
    <div class="row">
        <div class="col-lg-12">
            <% if (message) { %>
                <div class="alert alert-<%= message.type %> alert-dismissible fade show shadow-sm" role="alert">
                    <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
                    <i class="fas fa-check-circle me-2"></i><strong><%= message.message %></strong>
                </div>
            <% } %>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="text-primary fw-bold"><i class="fas fa-microchip me-2"></i>Inventario de Hardware</h2>
                <a href="/add" class="btn btn-primary shadow"><i class="fas fa-plus me-1"></i> Nuevo Producto</a>
            </div>

            <div class="card shadow border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <% if (components != '') { %>
                            <table class="table table-hover align-middle mb-0 text-center">
                                <thead class="bg-light">
                                    <tr class="text-secondary text-uppercase text-xs font-weight-bolder">
                                        <th>Imagen</th>
                                        <th>Nombre</th>
                                        <th>Marca</th>
                                        <th>Categoría</th>
                                        <th>Precio</th>
                                        <th>Stock</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% components.forEach((row, index) => { %>
                                        <tr>
                                            <td>
                                                <img src="/<%= row.image %>" width="60" height="60" class="img-thumbnail rounded-circle" style="object-fit: cover;">
                                            </td>
                                            <td class="fw-bold text-dark"><%= row.nombre %></td>
                                            <td><span class="badge bg-secondary"><%= row.marca %></span></td>
                                            <td><span class="badge bg-info text-dark"><%= row.categoria %></span></td>
                                            <td class="text-success fw-bold">$<%= row.precio %></td>
                                            <td>
                                                <% if(row.stock < 5) { %>
                                                    <span class="badge bg-danger">Bajo: <%= row.stock %></span>
                                                <% } else { %>
                                                    <span class="badge bg-success"><%= row.stock %></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <a href="/edit/<%= row._id %>" class="btn btn-sm btn-outline-success me-1"><i class="fas fa-edit"></i></a>
                                                <a href="/delete/<%= row._id %>" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } else { %>
                            <div class="text-center p-5">
                                <h4 class="text-muted">No hay componentes registrados</h4>
                                <p class="text-muted">¡Agrega el primero para comenzar!</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>